# NeuroAction Environment Configuration Example
# Copy this file to .env or web/frontend/.env.local for local overrides.

# ==============================================================================
# Frontend Configuration (web/frontend/)
# ==============================================================================
# Base URL for the FastAPI backend service
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8765

# ==============================================================================
# Backend Configuration (web/backend/)
# ==============================================================================
# Host and port for Uvicorn ASGI server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
