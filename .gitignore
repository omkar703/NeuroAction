# ==============================================================================
# NeuroAction — Git Ignore Rules
# ==============================================================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/

parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook Checkpoints (preserve .ipynb files!)
.ipynb_checkpoints/
*-checkpoint.ipynb

# Node.js & Next.js Builds
node_modules/
web/frontend/node_modules/
.next/
web/frontend/.next/
out/
web/frontend/out/
*.tsbuildinfo

# Deployment & Vercel
.vercel/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
web/frontend/.env.local

# OS Artifacts & Editor Dumps
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local Runtime Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.prompts
# Preserve Critical Research Assets
!results/
!results/**
!notebooks/*.ipynb
!models/
!models/**
!data/manifests/
!data/cache/
.dataset
/dataset
/.prompts